# ===== การตั้งค่าอีเมล (ส่งผ่าน Brevo API ทาง HTTPS) =====
# สมัครฟรีที่ https://www.brevo.com แล้วสร้าง API key (SMTP & API > API Keys)
BREVO_API_KEY=your-brevo-api-key-here

# อีเมลผู้ส่ง (ต้องยืนยัน sender นี้ใน Brevo ก่อน) — เช่น Gmail ของร้าน
SENDER_EMAIL=your-shop@gmail.com

# อีเมลร้าน (เจ้าของร้านจะได้รับคำเชิญและสลิปทุกครั้งที่มีการจอง)
OWNER_EMAIL=patiphan.tan@gmail.com

# ชื่อผู้ส่งที่แสดงในอีเมล
MAIL_FROM_NAME=24Lash Studio

# ===== LINE Official Account (ผูกคิว + เตือนคิว) =====
# 1) สร้าง LINE OA แล้วเปิด Messaging API ที่ https://developers.line.biz
# 2) คัดลอก Channel access token (long-lived) และ Channel secret มาใส่ที่นี่
# 3) ตั้ง Webhook URL = https://<โดเมนเว็บของคุณ>/api/line/webhook แล้วเปิด Use webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LINE ID ของ OA (มี @ นำหน้า เช่น @24lash) หาได้จากหน้า LINE OA Manager
LINE_OA_ID=

# ===== การเตือนคิว (เฟส 2) =====
# ชั่วโมง (0-23 เวลาไทย) ที่เริ่มส่งเตือนล่วงหน้า 1 วัน ของวันก่อนนัด (ค่าเริ่มต้น 18 = 6 โมงเย็น)
REMINDER_HOUR=18
# กุญแจลับสำหรับให้ cron ภายนอก (เช่น cron-job.org) เรียก /api/cron/reminders?key=... ได้
# ตั้งเป็นสตริงสุ่มยาวๆ (เช่นจาก: openssl rand -hex 16)
CRON_KEY=

# ===== ข้อมูลร้าน =====
SHOP_NAME=24Lash Studio
SHOP_ADDRESS=กรุณาระบุที่อยู่ร้านของคุณ
SHOP_PHONE=08X-XXX-XXXX

# ===== ข้อมูลการโอนมัดจำ =====
DEPOSIT_AMOUNT=300
BANK_NAME=ธนาคารกสิกรไทย
BANK_ACCOUNT_NAME=ชื่อบัญชีของร้าน
BANK_ACCOUNT_NUMBER=XXX-X-XXXXX-X
PROMPTPAY_ID=08X-XXX-XXXX

# พอร์ตเซิร์ฟเวอร์
PORT=3000

# โซนเวลา
TIMEZONE=Asia/Bangkok
